<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.QuizApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color = light gray, so no purple bar -->
        <item name="colorPrimary">#F3F4F6</item>
        <item name="colorPrimaryVariant">#E5E7EB</item>
        <item name="colorOnPrimary">#111827</item>

        <!-- Secondary brand color (used by Material components if needed) -->
        <item name="colorSecondary">#3B82F6</item>
        <item name="colorSecondaryVariant">#1D4ED8</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Optional: dark icons in status bar on light backgrounds -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
